# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Server-only. Read token for the private dataset — never expose to the browser.
SANITY_API_READ_TOKEN=

# PostHog product analytics
# Public project key. Safe to expose to the browser.
NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host. US cloud by default; use https://eu.i.posthog.com for EU cloud.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-only. Private API key for any server-side capture — never expose to the browser.
POSTHOG_API_KEY=
